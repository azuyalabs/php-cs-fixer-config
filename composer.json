{
  "name": "azuyalabs/php-cs-fixer-config",
  "description": "PHP CS Fixer config for AzuyaLabs projects",
  "license": "MIT",
  "type": "library",
  "keywords": [
    "PHP",
    "style",
    "configuration",
    "php-cs-fixer"
  ],
  "readme": "README.md",
  "authors": [
    {
      "name": "Sacha Telgenhof",
      "email": "me@sachatelgenhof.com",
      "homepage": "https://www.sachatelgenhof.com",
      "role": "Maintainer"
    }
  ],
  "homepage": "https://github.com/azuyalabs/php-cs-fixer-config",
  "support": {
    "issues": "https://github.com/azuyalabs/php-cs-fixer-config/issues",
    "source": "https://github.com/azuyalabs/php-cs-fixer-config",
    "docs": "https://github.com/azuyalabs/php-cs-fixer-config"
  },
  "funding": [
    {
      "type": "other",
      "url": "https://www.buymeacoffee.com/sachatelgenhof"
    }
  ],
  "require": {
    "php": "^8.2",
    "friendsofphp/php-cs-fixer": "^3.95"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.3",
    "phpunit/phpunit": "^10.5",
    "rector/rector": "^2.8"
  },
  "autoload": {
    "psr-4": {
      "AzuyaLabs\\PhpCsFixerConfig\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AzuyaLabs\\PhpCsFixerConfig\\Test\\": "tests"
    }
  },
  "config": {
    "platform": {
      "php": "8.2"
    },
    "sort-packages": true
  },
  "scripts": {
    "cs": "vendor/bin/php-cs-fixer fix -v --diff --dry-run",
    "cs-fix": "vendor/bin/php-cs-fixer fix -v",
    "phpstan": "vendor/bin/phpstan analyse",
    "rector": "vendor/bin/rector --dry-run",
    "rector-fix": "vendor/bin/rector",
    "test": "vendor/bin/phpunit"
  }
}
